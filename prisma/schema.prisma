// Prisma stub for future member profiles — not required to run the marketing site.
// Point DATABASE_URL at Postgres on Vercel when you enable accounts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  locale    String   @default("en")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
